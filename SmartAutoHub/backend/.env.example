# SmartAutoHub backend environment template
# Copy to backend/.env for local development only.
# In Azure App Service, set these values in Environment Variables.

NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Auth
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRE=30d

# Email (gmail or sendgrid)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
SENDGRID_API_KEY=

# External services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5000

# Dev-only toggles
# FRONTEND_DEV_SERVER=http://localhost:3000
# SERVE_FRONTEND_BUILD=false
